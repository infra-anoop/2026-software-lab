# Copy to `.env` in this directory (gitignored). `app.config.init_env()` loads it on startup.
# Canonical names = `ALL_ENV_NAMES` in app/config.py (Settings field aliases).
#
# --- Required for live LLM runs (GET /ready) ---
# OPENAI_API_KEY=sk-...
#
# --- Models (optional; default in code: app/config.py → DEFAULT_LLM_MODEL) ---
# SMART_WRITER_MODEL=openai:gpt-4o
# SMART_WRITER_MODEL_DECODER=openai:gpt-4o-mini
# SMART_WRITER_MODEL_RUBRIC=openai:gpt-4o-mini
# SMART_WRITER_MODEL_PLANNER=openai:gpt-4o-mini
# SMART_WRITER_MODEL_WRITER=openai:gpt-4o
# SMART_WRITER_MODEL_ASSESSOR=openai:gpt-4o-mini
# SMART_WRITER_MODEL_GROUNDING=openai:gpt-4o-mini
# SMART_WRITER_TEMPERATURE_DECODER=
# SMART_WRITER_TEMPERATURE_RUBRIC=
# SMART_WRITER_TEMPERATURE_PLANNER=
# SMART_WRITER_TEMPERATURE_WRITER=0.7
# SMART_WRITER_TEMPERATURE_ASSESSOR=
# SMART_WRITER_TEMPERATURE_GROUNDING=
# SMART_WRITER_MAX_TOKENS_DECODER=
# SMART_WRITER_MAX_TOKENS_RUBRIC=
# SMART_WRITER_MAX_TOKENS_PLANNER=
# SMART_WRITER_MAX_TOKENS_WRITER=4096
# SMART_WRITER_MAX_TOKENS_ASSESSOR=
# SMART_WRITER_MAX_TOKENS_GROUNDING=
#
# --- HTTP audit jobs (preview gate, not a user model) ---
# Unset SMART_WRITER_AUDIT_SECRET = POST /audit and GET /jobs return 503.
# Health and GET / stay public. GET /ready does not require this secret.
# The HTML form stores the value in sessionStorage and sends X-Audit-Secret from
# JavaScript. Convenience, not confidentiality against someone who loaded the page.
# SMART_WRITER_AUDIT_SECRET=change-me
# SMART_WRITER_AUDIT_TIMEOUT_SEC=300
# SMART_WRITER_JOB_CONCURRENCY=1
# SMART_WRITER_JOB_QUEUE_MAX=4
# SMART_WRITER_AUDIT_RATE_LIMIT_PER_MIN=5
#
# --- LLM retries (429 / 5xx / connection); see app/llm/retry.py ---
# SMART_WRITER_LLM_RETRY_MAX_ATTEMPTS=5
# SMART_WRITER_LLM_RETRY_BASE_SEC=1
# SMART_WRITER_LLM_RETRY_MAX_SEC=60
#
# --- Parallel OpenAI fan-out (rubric + assessor). Default also in code. ---
SMART_WRITER_MAX_CONCURRENT_LLM=1
#
# --- Supabase (optional; otherwise NullRepo, nothing in DB) ---
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SECRET_KEY=eyJ...
#
# --- Canonical library ---
# SMART_WRITER_EMBEDDING_MODEL=text-embedding-3-small
# SMART_WRITER_EMBEDDING_BATCH_SIZE=16
# SMART_WRITER_EMBEDDING_TIMEOUT_SEC=60
# SMART_WRITER_EMBEDDING_ON_FAILURE=skip_library
# SMART_WRITER_LIBRARY_REFRESH_ANCHORS=true
# SMART_WRITER_LIBRARY_MATCH_THRESHOLD=0.82
# SMART_WRITER_LIBRARY_MATCH_MARGIN=0
# SMART_WRITER_LIBRARY_MAX_MATCHES=3
# SMART_WRITER_CANONICAL_LIBRARY_PATH=
#
# --- Prompt program ---
# SMART_WRITER_PROMPTS_DIR=
# SMART_WRITER_PROMPT_PROGRAM=smart_writer_default
# SMART_WRITER_PROMPT_PROGRAM_VERSION=
# SMART_WRITER_PROMPT_PROFILE=
# SMART_WRITER_PROMPT_AUDIENCE=
# SMART_WRITER_PROMPT_WRITING_REGISTER=
# SMART_WRITER_PROMPT_LENGTH_TARGET=
# SMART_WRITER_PROMPT_RISK_TOLERANCE=
# SMART_WRITER_PROMPT_FORMALITY=
#
# --- Research planning / grounding / craft ---
# SMART_WRITER_RESEARCH_PLANNING_DEFAULT=true
# SMART_WRITER_PLANNING_MIN_CHARS=200
# SMART_WRITER_GROUNDING_TARGET=
# SMART_WRITER_DOMAIN_AGGREGATE_TARGET=
# SMART_WRITER_DOMAIN_PER_VALUE_FLOOR=
# SMART_WRITER_CRAFT_AGGREGATE_TARGET=
# SMART_WRITER_CRAFT_PER_VALUE_FLOOR=
# SMART_WRITER_VALUE_WEIGHTS=
# SMART_WRITER_CRAFT_KEYS=
# SMART_WRITER_CRAFT_ENABLED=true
# SMART_WRITER_CRAFT_WEIGHT_MASS=
#
# --- Retrieval (optional Tavily) ---
# SMART_WRITER_SEARCH_PROVIDER=none
# TAVILY_API_KEY=
# SMART_WRITER_MAX_URL_FETCHES=6
# SMART_WRITER_FETCH_DOMAIN_BLOCKLIST=
#
# --- Observability (optional) ---
# LOGFIRE_TOKEN=
