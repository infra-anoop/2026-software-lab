# Copy to `.env` in this directory (gitignored). Names only — never commit values.
# Canonical names = `ALL_ENV_NAMES` in app/config.py.

# --- Required for GET /ready (no upstream OpenAI call) ---
# OPENAI_API_KEY=sk-...

# --- Preview gate (mutating / job routes). Unset → 503 on protected routes. ---
# Never expose this to the Next.js client bundle (no NEXT_PUBLIC_*).
# SMART_WRITER_V2_AUDIT_SECRET=change-me

# --- Optional ---
# SMART_WRITER_V2_AUDIT_RATE_LIMIT_PER_MIN=5
# SMART_WRITER_V2_MAX_WRITE_JOBS_PER_CONVERSATION=3
# SMART_WRITER_V2_MAX_CLARIFY_TURNS_PER_CONVERSATION=10
# SMART_WRITER_V2_MAX_INNER_ASSESSOR_TURNS=8
# TAVILY_API_KEY=
# LOGFIRE_TOKEN=
